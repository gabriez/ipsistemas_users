# ==============================================================================
# Application Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# Security & Internal API Authentication
# Secret key required in the `x-api-key` header for n8n and internal API calls
# ==============================================================================
INTERNAL_API_KEY=change_this_to_a_secure_random_internal_api_key

# ==============================================================================
# Cryptographic Token Security
# Secret key used for HMAC-SHA-256 OTP hashing (falls back to INTERNAL_API_KEY if unset)
# ==============================================================================
OTP_SECRET=change_this_to_a_secure_random_hmac_secret

# ==============================================================================
# MariaDB Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=ipsistemas_user
DB_PASSWORD=ipsistemas_password
DB_ROOT_PASSWORD=root_password
DB_DATABASE=ipsistemas_users
DB_SSL=false
DB_LOGGING=false
DB_SYNCHRONIZE=false


OUTLINE_API_URL
OUTLINE_API_KEY
OUTLINE_WEBHOOK_SECRET
