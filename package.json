{
  "name": "express-template",
  "version": "1.0.0",
  "description": "Express Template - Gabriel Torres gabrieltorres2014@gmail.com",
  "license": "ISC",
  "author": "Gabriel Torres",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/database/appDataSource.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/database/appDataSource.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/database/appDataSource.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d ./src/database/appDataSource.ts",
    "prepare": "test -d .git && husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@inquirer/prompts": "^8.7.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/shelljs": "^0.10.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "shelljs": "^0.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "imports": {
    "#*": "./src/*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
